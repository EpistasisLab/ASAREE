# Copy to .env for local development.
#
# Same Postgres server as agentic-core's dev stack (port 5453), two separate
# databases: `agentic_core` (core's own schema, configured here so ASAREE can
# call configure() with the right connection) and `asaree` (ASAREE's own
# tables). See project_plan/core_asaree_use_case.md in the ARES repo.

ASAREE_DATABASE_URL=postgresql+asyncpg://agentic:agentic@localhost:5453/agentic_core
ASAREE_PRODUCT_DATABASE_URL=postgresql+asyncpg://agentic:agentic@localhost:5453/asaree
ASAREE_REDIS_URL=redis://localhost:6381/0

# Provider credentials — bare names, no ASAREE_ prefix (see CoreSettings).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Where the workspace MCP server (asaree.mcp_servers.workspace_server) stores
# per-cell versioned workspaces. MUST be an absolute path, not the relative
# default (asaree_workspace_core.workspace.WORKSPACE_ROOT falls back to
# "./data/workspaces", resolved against whatever spawned the reading process'
# OWN cwd). Domain-specific MCP servers (e.g. asaree-spinal-use-case/mcp-servers)
# are spawned with a DIFFERENT --directory than asaree-workspace, so a
# relative value resolves to two different, non-overlapping directories --
# open_workspace (asaree-workspace) succeeds while inspect_columns
# (asaree-sklearn-dc) reports "workspace not initialized" even immediately
# after, because each process resolved a different absolute path for the
# identical relative setting. Docker path shown; use an absolute host path
# if running ASAREE directly (not via docker compose).
ASAREE_DATASET_WORKSPACE_DIR=/app/data/workspaces
# MCP subprocess env allowlist (agentic_core.config.CoreSettings) — without
# this, the workspace server's subprocess never sees the setting above at
# all, regardless of what this process's own environment has.
#
# ASAREE_PRODUCT_DATABASE_URL is here for the same reason: workspace_server.py
# looks up registered datasets via asaree.models.database.get_session(), which
# reads settings.product_database_url -- inside that subprocess's own,
# separately-instantiated AsareeSettings, not the value this main process
# already resolved. Without this entry, the subprocess falls back to
# AsareeSettings' hardcoded default (localhost:5453) regardless of what this
# .env or compose.yml's environment: override actually set it to.
#
# No GIT_CONFIG_* entries here anymore: that was for domain-specific MCP
# servers git-fetching asaree-workspace-core from ASAREE's private repo at
# runtime, before they were decoupled onto the scratch-folder handoff /
# direct state.json reads (see mcp-servers/ in asaree-spinal-use-case) --
# nothing spawned by this process fetches a private repo at runtime anymore.
ASAREE_MCP_ALLOWED_ENV_VARS=ASAREE_DATASET_WORKSPACE_DIR,ASAREE_PRODUCT_DATABASE_URL

# Bundle root for core's own bundled OKF server (agentic_core.mcp_servers.okf,
# auto-registered as a global system server the same way asaree-workspace is —
# see app.py). Bare name, no ASAREE_ prefix: the server reads this directly
# from its own subprocess environment, and it's already in agentic-core's
# default MCP subprocess allowlist (a directory, not a secret), so no entry
# above is needed for it to reach the subprocess.
AGENTIC_OKF_BUNDLE_DIR=./data/okf-bundle

# agentic_core.config.CoreSettings.hook_timeout_seconds, ASAREE-prefixed
# (AsareeSettings's env_prefix applies -- no validation_alias override for
# this one). Bounds every pattern hook uniformly, both directions: reason_act's
# pre_act, where a real MCP tool call happens (can cold-start -- uv sync-ing a
# domain server's own venv on first use, or just a slow tool), and its own
# _post_reason, which makes a full LLM call (can be slow on a loaded Azure
# Foundry deployment). The 30s default is tuned for a generic core deployment,
# not for either of those. 3600s matches ARES's own production value
# (ARES_HOOK_TIMEOUT_SECONDS in its .env, undocumented in its own .env.example)
# for the identical reason -- "raised to match LLM call timeout... the default
# 30s causes run failures on slow Foundry responses." Raise per-deployment,
# not in core: core has no way to know how slow any given product's tools or
# provider responses are.
ASAREE_HOOK_TIMEOUT_SECONDS=3600
