# Copy to .env for local development.
#
# Same Postgres server as Motoro's dev stack (port 5453), two separate
# databases: `motoro` (core's own schema, configured here so ASAREE can
# call configure() with the right connection) and `asaree` (ASAREE's own
# tables). See project_plan/core_asaree_use_case.md in the ARES repo.

# Host port mappings for the containers Motoro's compose.yml starts. Read by
# compose interpolation (this file is the project's .env), and 5453/6381 are
# what the URLs below assume -- leaving POSTGRES_PORT unset would publish
# Postgres on 5432 instead and collide with any local install.
POSTGRES_PORT=5453
REDIS_PORT=6381

ASAREE_DATABASE_URL=postgresql+asyncpg://agentic:agentic@localhost:5453/motoro
ASAREE_PRODUCT_DATABASE_URL=postgresql+asyncpg://agentic:agentic@localhost:5453/asaree
ASAREE_REDIS_URL=redis://localhost:6381/0

# Set your provider key in the GUI instead: Profile -> LLM credentials, where
# it's stored per user and encrypted at rest. services/credential_resolver.py
# raises rather than falling back to the server environment for
# anthropic/openai/azure_foundry, so these two are ignored on the run path and
# normally stay empty. They remain as the bare-name (no ASAREE_ prefix, see
# CoreSettings) escape hatch for anything running outside a user's session.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Encrypts per-user LLM provider API keys at rest (user_llm_settings.
# api_key_encrypted -- see security/encryption.py).
#
# The value below is a working sample so a fresh checkout starts up complete,
# and it is fine for a throwaway local instance. It is committed to a public
# repo, so treat it as public: replace it with your own before this deployment
# stores a credential anyone cares about, since anyone who has it and can reach
# the database can decrypt every stored key. Do that BEFORE saving the first
# credential -- rotating it later leaves the existing rows undecryptable, and
# they have to be re-entered.
#
# Generate your own with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ASAREE_ENCRYPTION_KEY=VSrs26eW-By3hinbUIc8wTIdL8AP8VTm9_as2tqkgXs

# Where the workspace MCP server (asaree.mcp_servers.workspace_server) stores
# per-cell versioned workspaces. MUST be an absolute path, not the relative
# default (asaree_workspace_core.workspace.WORKSPACE_ROOT falls back to
# "./data/workspaces", resolved against whatever spawned the reading process'
# OWN cwd). Domain-specific MCP servers (e.g. asaree-spinal-use-case/mcp-servers)
# are spawned with a DIFFERENT --directory than asaree-workspace, so a
# relative value resolves to two different, non-overlapping directories --
# open_workspace (asaree-workspace) succeeds while inspect_columns
# (asaree-sklearn-dc) reports "workspace not initialized" even immediately
# after, because each process resolved a different absolute path for the
# identical relative setting. Docker path shown; use an absolute host path
# if running ASAREE directly (not via docker compose).
ASAREE_DATASET_WORKSPACE_DIR=/app/data/workspaces
# MCP subprocess env allowlist (motoro.config.CoreSettings) — without
# this, the workspace server's subprocess never sees the setting above at
# all, regardless of what this process's own environment has.
#
# ASAREE_PRODUCT_DATABASE_URL is here for the same reason: workspace_server.py
# looks up registered datasets via asaree.models.database.get_session(), which
# reads settings.product_database_url -- inside that subprocess's own,
# separately-instantiated AsareeSettings, not the value this main process
# already resolved. Without this entry, the subprocess falls back to
# AsareeSettings' hardcoded default (localhost:5453) regardless of what this
# .env or compose.yml's environment: override actually set it to.
#
# ASAREE_API_URL and ASAREE_INTERNAL_MCP_API_KEY are asaree-sklearn-eda's
# get_data_dictionary FALLBACK path -- calling back into this API for a
# dataset's registered dictionary_json when there's no ambient workspace to read
# it from (see ASAREE_INTERNAL_MCP_API_KEY below). The URL is set in compose.yml
# (the eda server's own localhost:8000 default is nothing from inside the
# container that spawns it).
#
# No GIT_CONFIG_* entries here anymore: that was for domain-specific MCP
# servers git-fetching asaree-workspace-core from ASAREE's private repo at
# runtime, before they were decoupled onto the scratch-folder handoff /
# direct state.json reads (see mcp-servers/) -- nothing spawned by this
# process fetches a private repo at runtime anymore.
ASAREE_MCP_ALLOWED_ENV_VARS=ASAREE_DATASET_WORKSPACE_DIR,ASAREE_PRODUCT_DATABASE_URL,ASAREE_API_URL,ASAREE_INTERNAL_MCP_API_KEY

# OPTIONAL, and normally left empty. asaree-sklearn-eda's get_data_dictionary
# reads the dictionary off the shared filesystem, from the copy
# asaree-workspace's open_workspace publishes into each cell's own workspace
# directory -- the same channel the train/test parquet already travel over. That
# needs no token and no network hop, and it's the path every cell run takes.
#
# This key is only the fallback for the case where there IS no ambient workspace:
# a tool called directly (a notebook, a manual MCP session) outside a cell run.
# Bare name, no ASAREE_ prefix in the reader (the eda server reads it straight
# from its own subprocess environment), and allowlisted above so it actually
# reaches that subprocess.
#
# If you do set it, it must be an ordinary user API token -- issue one from the
# GUI (Profile -> API tokens) or via sdk/README.md's Auth bootstrap. There is no
# sample value to ship here and no shared/static key: the API authenticates by
# looking up the token's hash in user_api_tokens, so an invented string is
# rejected exactly like no token at all. Datasets are owner-scoped too, so it
# decides WHOSE dictionaries the server can read.
ASAREE_INTERNAL_MCP_API_KEY=

# Bundle root for core's own bundled OKF server (motoro.mcp_servers.okf,
# auto-registered as a global system server the same way asaree-workspace is —
# see app.py). Bare name, no ASAREE_ prefix: the server reads this directly
# from its own subprocess environment, and it's already in Motoro's
# default MCP subprocess allowlist (a directory, not a secret), so no entry
# above is needed for it to reach the subprocess.
AGENTIC_OKF_BUNDLE_DIR=./data/okf-bundle

# motoro.config.CoreSettings.hook_timeout_seconds, ASAREE-prefixed
# (AsareeSettings's env_prefix applies -- no validation_alias override for
# this one). Bounds every pattern hook uniformly, both directions: reason_act's
# pre_act, where a real MCP tool call happens (can cold-start -- uv sync-ing a
# domain server's own venv on first use, or just a slow tool), and its own
# _post_reason, which makes a full LLM call (can be slow on a loaded Azure
# Foundry deployment). The 30s default is tuned for a generic core deployment,
# not for either of those. 3600s matches ARES's own production value
# (ARES_HOOK_TIMEOUT_SECONDS in its .env, undocumented in its own .env.example)
# for the identical reason -- "raised to match LLM call timeout... the default
# 30s causes run failures on slow Foundry responses." Raise per-deployment,
# not in core: core has no way to know how slow any given product's tools or
# provider responses are.
ASAREE_HOOK_TIMEOUT_SECONDS=3600
